<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs one maintenance sweep every 30 minutes on an always-on machine.

  Replace REPO_PATH with the checkout's absolute path and USERNAME with the
  account's short name, then:

    cp scripts/macos/dev.vidstube.maintain.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/dev.vidstube.maintain.plist

  See docs/runbooks/maintenance-runner.md.

  ProgramArguments runs a login shell on purpose. launchd gives a job a bare
  environment, so doppler, node and yt-dlp are not on the path otherwise, and
  the sweep would fail its preflight every half hour.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.vidstube.maintain</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd REPO_PATH &amp;&amp; npm run maintain</string>
  </array>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/vidstube-maintain.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/vidstube-maintain.error.log</string>
</dict>
</plist>
