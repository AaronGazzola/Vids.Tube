{
  "project": "My Project",
  "mainBranch": "main",
  "docs": {
    "roadmap": ["docs/roadmap.md"]
  },
  "integrations": {
    "git": {
      "enabled": true
    },
    "openspec": {
      "enabled": true
    },
    "skills": {
      "enabled": true,
      "repo": "git@github.com:AaronGazzola/AI-Resources.git",
      "path": ".claude/skills"
    },
    "linear": {
      "enabled": true,
      "workspace": "<linear-workspace>",
      "team": "<team-name-or-key>",
      "project": "<linear-project-name>"
    },
    "supabase": {
      "enabled": true,
      "projectRef": "<supabase-project-ref>"
    },
    "vercel": {
      "enabled": true
    },
    "doppler": {
      "enabled": false,
      "project": "<doppler-project>",
      "config": "<doppler-config>"
    },
    "sentry": {
      "enabled": false,
      "org": "<sentry-org>",
      "project": "<sentry-project>"
    },
    "trigger": {
      "enabled": false,
      "project": "<trigger-project-ref>"
    }
  }
}
